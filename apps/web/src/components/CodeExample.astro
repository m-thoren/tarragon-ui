---
import * as HTMLParser from 'prettier/parser-html'
import { Code } from 'astro:components'
import prettier from 'prettier'

type Props = {
	onlyCode?: boolean
}

const { onlyCode } = Astro.props

const code = await Astro.slots.render('default', [])

const withoutAttrsAndSvg = code
	.replace(/\sdata-astro-[\w-]+(?:="[^"]*"|='[^']*'|=[^\s>]+)?/g, '')
	.replace(/\sdata-testid="[^"]*"/g, '')
	.replace(/<svg\b[^>]*>[\s\S]*?<\/svg>/gi, '<Icon aria-hidden="true" />')

const formatted = await prettier.format(withoutAttrsAndSvg, {
	parser: 'html',
	plugins: [HTMLParser],
	htmlWhitespaceSensitivity: 'ignore',
})

const uuid = crypto.randomUUID()
---

{
	onlyCode ? (
		<Code code={formatted} lang='html' />
	) : (
		<>
			<slot />
			<label for={`code-example-${uuid}`}>
				<input id={`code-example-${uuid}`} role='switch' type='checkbox' />
				Show code
			</label>
			<tui-until-selected data-tui-target={`code-example-${uuid}`} class='hide-until-ready'>
				<Code code={formatted} lang='html' />
			</tui-until-selected>
		</>
	)
}

<style>
	pre {
		user-select: all;
	}
</style>
