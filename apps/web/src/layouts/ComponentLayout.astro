---
import { ArrowLeftIcon, ArrowRightIcon } from '@lucide/astro'
import { type Page, sections } from '@/scripts/constants'
import Layout from '@/layouts/Layout.astro'

type Props = {
	name: string
}

const { name } = Astro.props

const allPages: Array<Page> = sections.reduce<Array<Page>>(
	(accumulator, section) => accumulator.concat(section.pages),
	[],
)

const componentIndex = allPages.findIndex((c) => c.name === name)
const component = allPages[componentIndex]
const prevComponent = allPages.at(componentIndex - 1)
const nextComponent = allPages.at(componentIndex + 1 > allPages.length - 1 ? 0 : componentIndex + 1)
---

<Layout currentPage={component}>
	<div class='prose'>
		<div class='split'>
			<h1
				style={`view-transition-name: component-${component?.name.toLocaleLowerCase().replaceAll(' ', '-') ?? 'none'};`}
			>
				{component?.name ?? name}
			</h1>
			{
				(prevComponent || nextComponent) && (
					<div class='cluster'>
						{prevComponent && (
							<a href={prevComponent.href} class='btn outline size-icon'>
								<tui-boop>
									<ArrowLeftIcon aria-hidden='true' class='boop-bounce-left' />
								</tui-boop>
								<span class='visually-hidden'>Go to previous component</span>
							</a>
						)}
						{nextComponent && (
							<a href={nextComponent.href} class='btn outline size-icon'>
								<tui-boop>
									<ArrowRightIcon aria-hidden='true' class='boop-bounce-right' />
								</tui-boop>
								<span class='visually-hidden'>Go to next component</span>
							</a>
						)}
					</div>
				)
			}
		</div>
		{component?.description && <p class='text-muted'>{component.description}</p>}
		<slot />
	</div>
</Layout>
