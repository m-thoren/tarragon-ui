---
import CodeExample from '@/components/CodeExample.astro'
import ComponentLayout from '@/layouts/ComponentLayout.astro'
import { buildUrl } from '@/scripts/constants'
---

<ComponentLayout name='Ajax Form'>
	<CodeExample>
		<tui-ajax-form
			data-tui-query-key='ajax-form-example'
			data-tui-announce-id='ajax-form-announce'
		>
			<form method='PUT' action={buildUrl('/api/messages')}>
				<div class='form-group'>
					<label for='input-username'>
						Username
						<span class='font-medium'>(required)</span>
					</label>
					<input type='text' name='username' id='input-username' required />
				</div>
				<div class='form-group'>
					<label for='input-password'>
						Password
						<span class='font-medium'>(required)</span>
					</label>
					<input
						type='password'
						name='password'
						id='input-password'
						required
						minlength='8'
					/>
				</div>
				<div class='action-footer'>
					<button type='submit'>Submit</button>
				</div>
			</form>
			<div id='ajax-form-announce' role='status' class='alert visually-hidden max-w-form'>
				<div data-tui-announce-title class='alert-title'></div>
			</div>
		</tui-ajax-form>
	</CodeExample>
</ComponentLayout>
