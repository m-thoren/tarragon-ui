---
import { buildUrl, siteDescription, siteTitle } from '@/scripts/constants'
import { ArrowRightIcon } from '@lucide/astro'
import BrandIcon from '../assets/brand-icon.svg'
import RootLayout from '@/layouts/RootLayout.astro'
---

<RootLayout currentPage={undefined}>
	<main id='main' class='stack center gap-3xl padding-3xl flex-1'>
		<BrandIcon aria-hidden='true' class='tarragon-icon text-primary' />
		<h1 class='text-center w-full'>{siteTitle}</h1>
		<p class='text-center'>{siteDescription}</p>
		<a href={buildUrl('/installation')} class='btn'>
			Get started
			<tui-boop><ArrowRightIcon aria-hidden='true' class='boop-bounce-right' /></tui-boop>
		</a>
	</main>
</RootLayout>
<style>
	.tarragon-icon {
		max-width: min(var(--size-6xl), 60vw);
	}
</style>
