---
import { CircleAlertIcon, CircleCheckBigIcon, InfoIcon, TriangleAlertIcon } from '@lucide/astro'
import CodeExample from '@/components/CodeExample.astro'
import ComponentLayout from '@/layouts/ComponentLayout.astro'
---

<ComponentLayout name='Alert'>
	<CodeExample>
		<div class='alert'>
			<InfoIcon aria-hidden='true' />
			<h2>This is an alert</h2>
			<p class='alert-description'>With a description.</p>
		</div>
		<div class='alert'>
			<InfoIcon aria-hidden='true' />
			<h2>This Alert has only a title</h2>
		</div>
		<div class='alert'>
			<h2>This Alert does not have an icon</h2>
		</div>
	</CodeExample>

	<h2>Alert with links</h2>
	<p>Could be used for form summaries</p>
	<CodeExample>
		<div class='alert danger'>
			<CircleAlertIcon aria-hidden='true' />
			<h2>Unable to process your payment.</h2>
			<p>Please verify your billing information and try again.</p>
			<ul>
				<li>Check your card details</li>
				<li>Ensure sufficient funds</li>
				<li>Verify billing address</li>
				<li><a href='#test'>Input must have value</a></li>
			</ul>
		</div>
	</CodeExample>

	<h2>Variants</h2>
	<p>Use the variant classes success, warning or danger to change the color of the alert.</p>

	<h3>Info</h3>
	<CodeExample>
		<div class='alert'>
			<InfoIcon aria-hidden='true' />
			<h2>Default info alert</h2>
		</div>
	</CodeExample>

	<h3>Success</h3>
	<CodeExample>
		<div class='alert success'>
			<CircleCheckBigIcon aria-hidden='true' />
			<h2>Success! Your changes have been saved</h2>
		</div>
	</CodeExample>

	<h3>Warning</h3>
	<CodeExample>
		<div class='alert warning'>
			<TriangleAlertIcon aria-hidden='true' />
			<h2>This Alert is a warning</h2>
		</div>
	</CodeExample>

	<h3>Danger</h3>
	<CodeExample>
		<div class='alert danger'>
			<CircleAlertIcon aria-hidden='true' />
			<h2>An error occurred</h2>
		</div>
	</CodeExample>

	<h3>Accent</h3>
	<CodeExample>
		<div class='alert accent'>
			<CircleAlertIcon aria-hidden='true' />
			<h2>This is an accent alert</h2>
		</div>
	</CodeExample>

	<h2>Accessibility</h2>
	<p>
		To make the alert accessible to screen readers, use appropriate ARIA roles and properties.
		The alert should have a role of "region" and an aria-live attribute to announce updates.
	</p>
	<CodeExample>
		<div
			class='alert'
			aria-live='polite'
			aria-atomic='true'
			role='region'
			aria-labelledby='alert-title'
		>
			<InfoIcon aria-hidden='true' />
			<h2 id='alert-title'>Alert with aria attributes</h2>
			<p class='alert-description'>With a description.</p>
		</div>
	</CodeExample>

	<h3>Danger Status</h3>
	<p>
		For an alert with a danger status, use aria-live="assertive" to ensure that screen readers
		announce the update immediately.
	</p>
	<CodeExample>
		<div
			class='alert danger'
			aria-live='assertive'
			aria-atomic='true'
			role='region'
			aria-labelledby='alert-danger-title'
		>
			<CircleAlertIcon aria-hidden='true' />
			<h2 id='alert-danger-title'>Alert with aria-live="assertive"</h2>
			<p class='alert-description'>With a description.</p>
		</div>
	</CodeExample>
</ComponentLayout>
