---
import CodeExample from '@/components/CodeExample.astro'
import ComponentLayout from '@/layouts/ComponentLayout.astro'
---

<ComponentLayout name='Typography'>
	<CodeExample>
		<div class='stack'>
			<h1>Heading 1</h1>
			<h2>Heading 2</h2>
			<h3>Heading 3</h3>
			<h4>Heading 4</h4>
			<h5>Heading 5</h5>
			<h6>Heading 6</h6>
			<p>Paragraph</p>
			<blockquote>blockquote</blockquote>
			<code>@radix-ui/react-alert-dialog</code>
			<p class='text-lead'>Lead</p>
			<p class='font-bold'>Bold</p>
			<p class='font-italic'>Italic</p>
			<p class='text-lg'>Large</p>
			<p class='text-sm'>Small</p>
			<p class='text-muted'>Muted</p>
		</div>
	</CodeExample>

	<CodeExample>
		<ol>
			<li>1st</li>
			<li>2nd</li>
			<li>3rd</li>
		</ol>

		<ul>
			<li>1st</li>
			<li>2nd</li>
			<li>3rd</li>
		</ul>

		<ul class='list-none'>
			<li>1st</li>
			<li>2nd</li>
			<li>3rd</li>
		</ul>
	</CodeExample>

	<CodeExample>
		<dl>
			<div>
				<dt>Product ID</dt>
				<dd>12345</dd>
			</div>
			<div>
				<dt>Product Name</dt>
				<dd>Example Product</dd>
			</div>
			<div>
				<dt>Type</dt>
				<dd>Example Type</dd>
			</div>
			<div>
				<dt>Serial Number</dt>
				<dd>EB12345</dd>
			</div>
			<div>
				<dt>Launch Date</dt>
				<dd>2023-01-01</dd>
			</div>
			<div>
				<dt>Make</dt>
				<dd>Example Make</dd>
			</div>
		</dl>
	</CodeExample>

	<CodeExample>
		<div>
			<table>
				<thead>
					<tr>
						<th>King's Treasury</th>
						<th>People's happiness</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>Empty</td>
						<td>Overflowing</td>
					</tr>
					<tr>
						<td>Modest</td>
						<td>Satisfied</td>
					</tr>
					<tr>
						<td>Full</td>
						<td>Ecstatic</td>
					</tr>
				</tbody>
			</table>
		</div>
	</CodeExample>
</ComponentLayout>
