---
import CodeExample from '@/components/CodeExample.astro'
import ComponentLayout from '@/layouts/ComponentLayout.astro'
import { Image } from 'astro:assets'
import { TriangleAlertIcon } from '@lucide/astro'
---

<ComponentLayout name='Carousel'>
	<div class='alert warning'>
		<TriangleAlertIcon aria-hidden='true' />
		<h2>This component is still in development</h2>
	</div>
	<CodeExample>
		<ul class='carousel'>
			<li>
				<figure>
					<Image
						class='image w-full'
						src='https://images.unsplash.com/photo-1773062189964-75a471b19934?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D'
						width={300}
						height={300}
						alt='A blue vinyl record player on a wooden side table'
					/>
				</figure>
			</li>
			<li>
				<figure>
					<Image
						class='image w-full'
						src='https://images.unsplash.com/photo-1773062189964-75a471b19934?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D'
						width={300}
						height={300}
						alt='A blue vinyl record player on a wooden side table'
					/>
				</figure>
			</li>
			<li>
				<figure>
					<Image
						class='image w-full'
						src='https://images.unsplash.com/photo-1773062189964-75a471b19934?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D'
						width={300}
						height={300}
						alt='A blue vinyl record player on a wooden side table'
					/>
				</figure>
			</li>
			<li>
				<figure>
					<Image
						class='image w-full'
						src='https://images.unsplash.com/photo-1773062189964-75a471b19934?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D'
						width={300}
						height={300}
						alt='A blue vinyl record player on a wooden side table'
					/>
				</figure>
			</li>
		</ul>
	</CodeExample>
</ComponentLayout>

<style>
	.carousel {
		list-style: none;
		padding: 0;
		display: flex;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		gap: 16px;
		scroll-marker-group: after;
	}

	.carousel li {
		flex: 0 0 100%;
		scroll-snap-align: center;
		margin: 0;
	}

	.carousel::scroll-button(left) {
		content: '←' / 'Previous';
	}
	.carousel::scroll-button(right) {
		content: '→' / 'Next';
	}

	.carousel li::scroll-marker {
		content: '';
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: #ccc;
	}

	.carousel li::scroll-marker:target-current {
		background: #7c3aed;
	}
</style>
